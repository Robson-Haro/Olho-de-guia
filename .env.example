NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GUPY_API_BASE_URL=https://api.gupy.io/api/v1
TOKEN_ENCRYPTION_KEY=
ADMIN_EMAIL=

# Senha administrativa exigida para GRAVAR a chave do Serper e o token da Gupy.
# Mínimo de 16 caracteres. Sem ela, a gravação de credenciais fica bloqueada:
# as rotas /api/admin/* não tinham autenticação e qualquer pessoa com o
# endereço do sistema podia sobrescrever as duas credenciais.
EUREKA_ADMIN_KEY=

# Créditos do Serper por busca (6 a 30; padrão 12). Cada consulta de 100
# resultados custa 2 créditos.
EUREKA_SERPER_BUDGET=12

# ---------------------------------------------------------------------
# CAMADA DE LEITURA (Onda 2). Sem chave, o sistema funciona exatamente
# como na Onda 1, decidindo pelo léxico. Com chave, o modelo lê a vaga e
# amplia o vocabulário de busca sozinho, e escreve o parecer de cada
# perfil do topo.
# ---------------------------------------------------------------------
# anthropic (padrão) | openai | compatible
EUREKA_LLM_PROVIDER=anthropic
EUREKA_LLM_API_KEY=
# Opcional. Padrão: claude-haiku-4-5-20251001 (anthropic) ou gpt-5.4-nano (openai).
EUREKA_LLM_MODEL=
# Obrigatório apenas no modo "compatible" (endpoint no formato da OpenAI).
EUREKA_LLM_BASE_URL=
# Quantos perfis do topo recebem parecer por busca (5 a 40; padrão 25).
EUREKA_LLM_REVIEW_LIMIT=25
# Preço do modelo, apenas para exibir o custo estimado na tela.
EUREKA_LLM_INPUT_USD_PER_MTOK=1
EUREKA_LLM_OUTPUT_USD_PER_MTOK=5
