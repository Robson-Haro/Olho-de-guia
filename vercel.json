{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": { "root": ".", "framework": "nextjs" },
    "intelligence": { "root": "python-service/", "entrypoint": "main:app" }
  },
  "rewrites": [
    {
      "source": "/svc/intelligence/:path*",
      "destination": { "service": "intelligence" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
